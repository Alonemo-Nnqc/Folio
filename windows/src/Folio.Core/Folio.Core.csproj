<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that is not UI: library database, metadata retrieval, citations, translation, AI tools.
       Builds and tests on any OS (dotnet test runs on macOS too); the WinUI app and folio-cli sit on top. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Folio.Core</RootNamespace>
    <AssemblyName>Folio.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <!-- Shared with the macOS app: the same strings (zh-Hans source, English translations) and citation styles. -->
  <ItemGroup>
    <EmbeddedResource Include="$(FolioMacRoot)Folio\Resources\Localizable.xcstrings" LogicalName="strings.app.xcstrings" />
    <EmbeddedResource Include="$(FolioMacRoot)Packages\FolioCore\Sources\FolioCore\Resources\Localizable.xcstrings" LogicalName="strings.core.xcstrings" />
    <EmbeddedResource Include="$(FolioMacRoot)Packages\FolioCore\Sources\FolioCitation\Localization\Localizable.xcstrings" LogicalName="strings.citation.xcstrings" />
    <EmbeddedResource Include="$(FolioMacRoot)Packages\FolioCore\Sources\FolioTranslate\Resources\Localizable.xcstrings" LogicalName="strings.translate.xcstrings" />
    <EmbeddedResource Include="$(FolioMacRoot)Packages\FolioCore\Sources\FolioAgent\Resources\Localizable.xcstrings" LogicalName="strings.agent.xcstrings" />
    <EmbeddedResource Include="Resources\Windows.xcstrings" LogicalName="strings.windows.xcstrings" />
    <EmbeddedResource Include="Resources\latin.txt" LogicalName="latin.txt" />
    <EmbeddedResource Include="$(FolioMacRoot)Packages\FolioCore\Sources\FolioCitation\Resources\*.csl" LogicalName="csl.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(FolioMacRoot)Packages\FolioCore\Sources\FolioCitation\Resources\*.xml" LogicalName="csl.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(FolioMacRoot)Packages\FolioCore\Sources\FolioCitation\Resources\citeproc_commonjs.js" LogicalName="csl.citeproc_commonjs.js" />
  </ItemGroup>
</Project>
