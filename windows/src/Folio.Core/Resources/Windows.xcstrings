    "已是最新版本" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You're up to date" } }} },
    "Folio %@ 是目前最新的 Windows 版本。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Folio %@ is the latest version for Windows." } }} },
    "无法检查更新：%@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't check for updates: %@" } }} },
