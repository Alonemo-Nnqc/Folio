    "有新版本可用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A new version is available" } }} },
    "Folio %@ 已下载，重新启动即可完成安装。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Folio %@ has been downloaded. Restart to finish installing it." } }} },
    "立即重新启动" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Restart Now" } }} },
