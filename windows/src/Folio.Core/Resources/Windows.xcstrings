{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "%lld 篇正在翻译" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld translating" } } } },
    "版本 %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Version %@" } } } },
    "Google、Microsoft 互为备用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Google and Microsoft stand in for each other" } } } },
    "设置（Ctrl+,）" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Settings (Ctrl+,)" } } } },
    "正在下载…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Downloading…" } } } },
    "自动下载更新" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Download Updates Automatically" } } } },
    "快速预览" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Quick Look" } } } },
    "关闭（空格）" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close (Space)" } } } },
    "用默认应用打开" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open in Default App" } } } },
    "这个条目没有附件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This item has no attachment" } } } },
    "点按后按下新的快捷键；Backspace 恢复默认" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Click, then press a new shortcut. Backspace restores the default." } } } },
    "可直接打开 Mac 版的文献库文件夹，两端格式相同" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Libraries from the Mac app open here directly; the format is the same" } } } },
    "点击“安装”后，在浏览器扩展页面开启“开发者模式”，选择“加载已解压的扩展程序”并选中 Folio 打开的文件夹" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "After clicking Install, turn on Developer mode on the browser's extensions page, choose Load unpacked, and pick the folder Folio opens" } } } },
    "自定义工具栏" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Customize Toolbar" } } } },
    "AI 智能体" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "AI Agents" } } } },
    "从 Zotero 迁移" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Migrate from Zotero" } } } },
    "全屏" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Full Screen" } } } },
    "在 Folio 阅读器中添加的高亮和批注会显示在这里" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Highlights and notes added in the Folio reader appear here" } } } },
    "在资源管理器中显示文献库" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show Library in File Explorer" } } } },
    "整篇翻译" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Full-Text Translation" } } } },
    "浏览器插件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Browser Extension" } } } },
    "菜单" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Menu" } } } },
    "轻量的文献管理软件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A lightweight reference manager" } } } },
    "还没有文献" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Papers Yet" } } } },
