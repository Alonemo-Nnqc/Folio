    "已导入 %lld 篇文献，%lld 篇已在文献库中" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Imported %lld items; %lld were already in the library" } }} },
    "已导出 %lld 篇文献" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Exported %lld items" } }} },
