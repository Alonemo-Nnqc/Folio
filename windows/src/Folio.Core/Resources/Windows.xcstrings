    "引用与导出" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cite and Export" } }} },
    "思考强度" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Thinking" } }} },
    "思考强度：%@（由所选模型决定）" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Thinking: %@ (set by the chosen model)" } }} },
    "所选文献已在「%@」中" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The selected items are already in “%@”" } }} },
    "所选文献没有可引用的元数据" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The selected items have no metadata to cite" } }} },
    "所选文献没有可翻译的 PDF" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The selected items have no PDF to translate" } }} },
    "手动匹配元数据…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Match Metadata Manually…" } }} },
    "打开 PDF 的方式" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open PDFs with" } }} },
    "打开其他文献库…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Another Library…" } }} },
    "打开未读文献时标记为在读" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Mark unread items as reading when opened" } }} },
    "找不到文件「%@」" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The file “%@” cannot be found" } }} },
    "把 PDF 前几页的文字与版面发送给 Zotero 的识别服务，能识别更多没有 DOI 的论文。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sends the text and layout of the first pages of a PDF to Zotero’s recognition service, which recognizes more papers without a DOI." } }} },
    "按“作者_年份_标题”自动重命名文件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rename files as “Author_Year_Title” automatically" } }} },
    "接收测试版" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Receive beta versions" } }} },
    "插件会以“已解压的扩展程序”方式加载：点击“安装”后，Folio 准备好插件文件夹并打开浏览器的扩展页面，打开“开发者模式”，选择“加载已解压的扩展程序”，再选中这个文件夹。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The extension is loaded as an “unpacked extension”: click “Install”, and Folio prepares its folder and opens the browser’s extensions page. Turn on “Developer mode”, choose “Load unpacked”, and select that folder." } }} },
    "插件文件夹的路径已复制，在扩展页面中选择“加载已解压的扩展程序”" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The path of the extension folder has been copied. Choose “Load unpacked” on the extensions page." } }} },
    "数据源" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sources" } }} },
    "文件名" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "File Name" } }} },
    "文献和文件将被永久删除，无法恢复。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The items and their files will be deleted permanently. This cannot be undone." } }} },
    "文献库中已有「%@」" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "“%@” is already in the library" } }} },
    "新建分组…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "New Group…" } }} },
    "新建子分组…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "New Subgroup…" } }} },
    "无法保存标注：%@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not save the annotation: %@" } }} },
    "无法移动文献库" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not move the library" } }} },
    "显示/隐藏侧栏" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show/Hide Sidebar" } }} },
    "更新" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Updates" } }} },
    "更新从 GitHub Releases 下载，在后台完成，重新启动即完成安装。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Updates are downloaded from GitHub Releases in the background and installed when Folio restarts." } }} },
    "服务%@的上游拒绝了请求（426）：%@。这个版本号是该接口服务自己上报的，和这台电脑上安装的命令行工具无关，请更新这个接口服务（例如 grok2api）或在它的设置里改高版本号" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The upstream of the service%@refused the request (426): %@. This version number is reported by the API service itself and has nothing to do with the command-line tools on this computer. Update the API service (for example grok2api) or raise the version number in its settings." } }} },
    "未保存为配置" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Not saved as a configuration" } }} },
