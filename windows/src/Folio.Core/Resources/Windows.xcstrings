    "已将 %lld 项移到回收站" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Moved %lld items to the Trash" } }} },
    "已添加 %lld 个文件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Added %lld files" } }} },
    "已添加 %lld 篇文献" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Added %lld items" } }} },
    "已添加 %lld 篇，%lld 个未找到" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Added %lld items; %lld not found" } }} },
    "已移到回收站" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Moved to the Trash" } }} },
