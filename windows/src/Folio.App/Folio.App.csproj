<Project Sdk="Microsoft.NET.Sdk">
  <!-- Folio for Windows: WinUI 3, unpackaged and self-contained (no runtime to install), installed and updated by Velopack. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Folio.App</RootNamespace>
    <AssemblyName>Folio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Folio.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Folio.Core\Folio.Core.csproj" />
  </ItemGroup>

  <!-- pdf.js is fetched (pinned, checksummed) instead of being committed. -->
  <Target Name="FetchPdfJs" BeforeTargets="BeforeBuild" Condition="!Exists('$(MSBuildProjectDirectory)\Assets\pdfjs\.version')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\fetch-pdfjs.ps1&quot;" />
    <ItemGroup>
      <Content Include="Assets\pdfjs\**\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The reader page around pdf.js; pdf.js itself is fetched by scripts/fetch-pdfjs.ps1 into Assets\pdfjs. -->
    <Content Include="Reader\Web\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The browser extension is shared with the macOS app; Folio installs it from this copy (unpacked). -->
    <Content Include="..\..\..\BrowserExtension\**\*" LinkBase="BrowserExtension" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
