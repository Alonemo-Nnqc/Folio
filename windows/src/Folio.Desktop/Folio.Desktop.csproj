<Project Sdk="Microsoft.NET.Sdk">
  <!-- Folio for Windows: a thin WinForms host around WebView2. The interface is windows/web; everything else is Folio.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Folio.App</RootNamespace>
    <AssemblyName>Folio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Folio.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWindowsForms>true</UseWindowsForms>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Precompiled: no JIT at launch. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>false</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Folio.Core\Folio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The interface, built from windows/web (pnpm build), copied here as it is. -->
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- The browser extension is shared with the macOS app; Folio installs it from this copy (unpacked). -->
    <Content Include="..\..\..\BrowserExtension\**\*" LinkBase="BrowserExtension" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The interface has to be built first; nothing would show without it. -->
  <Target Name="RequireInterface" BeforeTargets="BeforeBuild" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\index.html')">
    <Error Text="The interface is missing: run 'pnpm install' and 'pnpm build' in windows/web first." />
  </Target>
</Project>
