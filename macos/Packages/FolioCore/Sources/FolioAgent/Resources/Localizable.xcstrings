    "无法启动 folio-cli：%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't start folio-cli: %@"
          }
        }
      }
    },
    "无法解析 %@（%@），为避免破坏它，请手动添加：\n%@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "无法解析 %1$@（%2$@），为避免破坏它，请手动添加：\n%3$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't parse %1$@ (%2$@). To avoid damaging it, please add this by hand:\n%3$@"
          }
        }
      }
    },
    "未能添加 %@ 的配置，请检查 %@。" : {
